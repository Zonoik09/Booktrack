# Copia este fichero a .env y rellena los valores.
#   cp .env.example .env

# OBLIGATORIO. Firma los tokens de sesión.
# Genera uno con:  openssl rand -hex 32
# Si lo cambias, se cierran todas las sesiones abiertas.
JWT_SECRET=

# Código de invitación para darse de alta.
# El servidor es accesible desde internet por el túnel, así que sin código
# cualquiera podría crearse una cuenta. Pásaselo a quien quieras invitar.
INVITE_CODE=cambia-esto

# Pon 0 cuando ya tengáis todas las cuentas creadas y no quieras más altas.
REGISTRATION_ENABLED=1

MIN_PASSWORD_LENGTH=8
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=60
LOG_LEVEL=info
